<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules. The Gemini API key is encrypted with a device-bound Keystore
   key, so it must never be restored onto another device.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="raazi_gemini.xml" />
    <exclude domain="sharedpref" path="raazi_web_verify.xml" />
</full-backup-content>
