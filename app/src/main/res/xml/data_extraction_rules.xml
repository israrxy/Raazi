<?xml version="1.0" encoding="utf-8"?><!--
   Android 12+ backup / device-transfer rules. The Gemini key is bound to the
   device's Android Keystore and cannot be decrypted elsewhere.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="raazi_gemini.xml" />
        <exclude domain="sharedpref" path="raazi_web_verify.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="raazi_gemini.xml" />
        <exclude domain="sharedpref" path="raazi_web_verify.xml" />
    </device-transfer>
</data-extraction-rules>
